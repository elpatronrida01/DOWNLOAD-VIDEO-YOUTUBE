# MediaFetch - Environment Configuration Example

# APP_URL: The public URL where this applet is hosted (auto-injected in Cloud Run).
APP_URL="http://localhost:3000"

# Server Port
PORT=3000

# Environment Mode: 'development' or 'production'
NODE_ENV="development"

# Security & Rate Limiting: Max requests per minute per IP
RATE_LIMIT_MAX_REQUESTS=60

# Playlist Settings: Max items to process in a single batch
MAX_PLAYLIST_ITEMS=100

# Optional External Extractor / Worker URL (e.g. self-hosted yt-dlp microservice on residential IP or VPS)
# Leave blank to use built-in Node.js + FFmpeg media engine
EXTERNAL_WORKER_URL=""

# Optional Proxy URL (HTTP/HTTPS) for upstream requests
HTTP_PROXY=""
